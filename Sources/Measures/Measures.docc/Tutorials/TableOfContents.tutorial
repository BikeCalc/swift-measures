@Tutorials(name: "Swift Measures") {
    @Intro(title: "Build with Measures") {
        Define custom units, calculate across dimensions, convert and canonicalize results with property wrappers, and
        format measures for different locales.
    }

    @Chapter(name: "Creating Custom Units") {
        @Image(
            source: "Chapter1Banner.png",
            alt: "The Swift Measures logo beside illustrations of measuring instruments."
        )

        @TutorialReference(tutorial: "doc:CreatingACustomDimension")
    }

    @Chapter(name: "Calculating Composed Units") {
        @Image(
            source: "Chapter2Banner.png",
            alt: "The Swift Measures logo beside illustrations of measuring instruments."
        )

        @TutorialReference(tutorial: "doc:CalculatingAcrossDimensions")
    }

    @Chapter(name: "Formatting Measures") {
        @Image(
            source: "Chapter3Banner.png",
            alt: "The Swift Measures logo beside illustrations of measuring instruments."
        )

        @TutorialReference(tutorial: "doc:FormattingMeasures")
    }
}
